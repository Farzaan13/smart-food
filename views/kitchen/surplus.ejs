<div class="container py-5">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Surplus Food
            </h1>

            <p class="text-muted mb-0">
                Make extra food available for redistribution.
            </p>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0">

            <a
                href="/dashboard/kitchen"
                class="btn btn-outline-secondary">

                ← Dashboard

            </a>

            <button
                type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#surplusModal">

                + Add Surplus

            </button>

        </div>

    </div>


    <!-- ============================= -->
    <!-- LISTINGS -->
    <!-- ============================= -->

    <div class="row g-4">

        <% if (!surplusFoods || surplusFoods.length === 0) { %>

            <div class="col-12">

                <div class="card border-0 shadow-sm">

                    <div class="card-body text-center py-5">

                        <div class="mb-3">
                            <span style="font-size: 3rem;">🍱</span>
                        </div>

                        <h5 class="fw-bold">
                            No surplus food listed
                        </h5>

                        <p class="text-muted mb-4">
                            Add available surplus food for NGOs
                            and community kitchens.
                        </p>

                        <button
                            type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#surplusModal">

                            + Add Your First Surplus

                        </button>

                    </div>

                </div>

            </div>

        <% } %>


        <% if (surplusFoods && surplusFoods.length > 0) { %>

            <% surplusFoods.forEach(food => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <!-- Food Name + Status -->

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h5 class="fw-bold mb-0">

                                    <%= food.foodName %>

                                </h5>

                                <span class="badge
                                    <%= food.status === 'available'
                                        ? 'bg-success'
                                        : food.status === 'requested'
                                        ? 'bg-warning text-dark'
                                        : 'bg-secondary' %>">

                                    <%= food.status.replaceAll("_", " ") %>

                                </span>

                            </div>


                            <!-- Category -->

                            <p class="text-muted text-capitalize mb-3">

                                <%= food.category.replaceAll("_", " ") %>

                            </p>


                            <!-- Quantity -->

                            <div class="mb-3">

                                <small class="text-muted">
                                    Available Quantity
                                </small>

                                <h3 class="fw-bold text-success mb-0">

                                    <%= food.quantity %>
                                    <%= food.unit %>

                                </h3>

                            </div>


                            <hr>


                            <!-- Prepared Time -->

                            <p class="mb-2">

                                <strong>
                                    Prepared:
                                </strong>

                                <br>

                                <span class="text-muted">

                                    <%= new Date(
                                        food.preparedAt
                                    ).toLocaleString() %>

                                </span>

                            </p>


                            <!-- Pickup Deadline -->

                            <p class="mb-2">

                                <strong>
                                    Pickup before:
                                </strong>

                                <br>

                                <span class="text-muted">

                                    <%= new Date(
                                        food.pickupDeadline
                                    ).toLocaleString() %>

                                </span>

                            </p>


                            <!-- Location -->

                            <p class="mb-2">

                                <strong>
                                    City:
                                </strong>

                                <span class="text-muted">
                                    <%= food.city %>
                                </span>

                            </p>


                            <!-- Pickup Address -->

                            <p class="mb-2">

                                <strong>
                                    Pickup Address:
                                </strong>

                                <br>

                                <span class="text-muted">

                                    <%= food.pickupAddress %>

                                </span>

                            </p>


                            <!-- Description -->

                            <% if (food.description) { %>

                                <div class="mt-2 mb-3">

                                    <strong>
                                        Description:
                                    </strong>

                                    <p class="text-muted mb-0">

                                        <%= food.description %>

                                    </p>

                                </div>

                            <% } %>


                            <!-- Actions -->

                            <div class="mt-auto pt-3">

                                <% if (food.status === "available") { %>

                                    <form
                                        action="/dashboard/kitchen/surplus/<%= food._id %>/cancel"
                                        method="POST">

                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger btn-sm w-100">

                                            Cancel Listing

                                        </button>

                                    </form>

                                <% } else { %>

                                    <div class="alert alert-light border mb-0">

                                        <small class="text-muted">

                                            This listing is currently
                                            <strong>
                                                <%= food.status.replaceAll("_", " ") %>
                                            </strong>.

                                        </small>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        <% } %>

    </div>

</div>



<!-- ===================================================== -->
<!-- ADD SURPLUS FOOD MODAL -->
<!-- ===================================================== -->

<div
    class="modal fade"
    id="surplusModal"
    tabindex="-1"
    aria-labelledby="surplusModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- Modal Header -->

            <div class="modal-header">

                <div>

                    <h5
                        class="modal-title fw-bold"
                        id="surplusModalLabel">

                        Add Surplus Food

                    </h5>

                    <small class="text-muted">

                        Add extra food available for redistribution.

                    </small>

                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>


            <!-- Form -->

            <form
                action="/dashboard/kitchen/surplus"
                method="POST"
                 id="surplusForm">

                <div class="modal-body">

                    <div class="row g-3">


                        <!-- Food Name -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Food Name

                            </label>

                            <input
                                type="text"
                                name="foodName"
                                class="form-control"
                                placeholder="e.g. Vegetable Rice"
                                required>

                        </div>


                        <!-- Category -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Category

                            </label>

                            <select
                                name="category"
                                class="form-select"
                                required>

                                <option value="cooked_food">
                                    Cooked Food
                                </option>

                                <option value="raw_material">
                                    Raw Material
                                </option>

                                <option value="bakery">
                                    Bakery
                                </option>

                                <option value="fruits_vegetables">
                                    Fruits & Vegetables
                                </option>

                                <option value="dairy">
                                    Dairy
                                </option>

                                <option value="other">
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Quantity -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Quantity

                            </label>

                            <input
                                type="number"
                                name="quantity"
                                class="form-control"
                                placeholder="e.g. 50"
                                min="1"
                                step="0.1"
                                required>

                        </div>


                        <!-- Unit -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Unit

                            </label>

                            <select
                                name="unit"
                                class="form-select"
                                required>

                                <option value="plates">
                                    Plates
                                </option>

                                <option value="kg">
                                    Kg
                                </option>

                                <option value="litres">
                                    Litres
                                </option>

                                <option value="units">
                                    Units
                                </option>

                            </select>

                        </div>


                        <!-- Prepared At -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Prepared At

                            </label>

                            <input
                                type="datetime-local"
                                name="preparedAt"
                                class="form-control"
                                required>

                        </div>


                        <!-- Pickup Deadline -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Pickup Deadline

                            </label>

                            <input
                                type="datetime-local"
                                name="pickupDeadline"
                                id="pickupDeadline"
                                class="form-control"
                                required>

                        </div>


                        <!-- City -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                City

                            </label>

                            <input
                                type="text"
                                name="city"
                                class="form-control"
                                placeholder="e.g. Kanpur"
                                required>

                        </div>


                        <!-- Pickup Address -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">

                                Pickup Address

                            </label>

                            <input
                                type="text"
                                name="pickupAddress"
                                class="form-control"
                                placeholder="Kitchen pickup address"
                                required>

                        </div>


                        <!-- Description -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea
                                name="description"
                                class="form-control"
                                rows="3"
                                placeholder="Food details, packaging, quantity details, etc."></textarea>

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="btn btn-success">

                        + Add Surplus Food

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const form = document.getElementById("surplusForm");

    const preparedAt = document.getElementById("preparedAt");
    const pickupDeadline = document.getElementById("pickupDeadline");

    // Current date-time ko input ke format me convert karta hai
    const now = new Date();

    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, "0");
    const day = String(now.getDate()).padStart(2, "0");
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");

    const currentDateTime =
        `${year}-${month}-${day}T${hours}:${minutes}`;

    // Prepared date future se bahut invalid na ho
    preparedAt.max = currentDateTime;

    form.addEventListener("submit", (event) => {

        const preparedDate = new Date(preparedAt.value);
        const deadlineDate = new Date(pickupDeadline.value);

        // Invalid date check
        if (isNaN(preparedDate.getTime())) {

            event.preventDefault();

            alert("Please enter a valid Prepared At date.");

            preparedAt.focus();

            return;
        }

        if (isNaN(deadlineDate.getTime())) {

            event.preventDefault();

            alert("Please enter a valid Pickup Deadline.");

            pickupDeadline.focus();

            return;
        }

        // Pickup deadline prepared time ke baad honi chahiye
        if (deadlineDate <= preparedDate) {

            event.preventDefault();

            alert(
                "Pickup Deadline must be later than Prepared At."
            );

            pickupDeadline.focus();

            return;
        }

    });

});
</script>